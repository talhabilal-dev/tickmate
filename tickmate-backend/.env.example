# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
COOKIE_DOMAIN=localhost

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tickmate

# Auth
# Long random string (at least 32 chars). Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# Email (Resend) - optional
# Emails are skipped with a warning when not configured.
RESEND_API_KEY=
EMAIL_FROM=tickmate@yourdomain.com

# Inngest (event-driven background jobs) - optional
# Jobs are skipped when not configured.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI (ticket analysis + embeddings) - optional
# AI features degrade gracefully when not configured.
OPENAI_API_KEY=

# Google Gemini - optional
GEMINI_API_KEY=

# Qdrant (vector search for similar tickets) - optional
# Similar-ticket search is skipped when not configured.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
SIMILAR_TICKET_MIN_SCORE=0.3